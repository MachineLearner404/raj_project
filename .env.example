# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is git-ignored — see .gitignore.

# --- Supabase (required) ---
# Project URL, from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key — safe for the browser bundle because Row Level Security
# policies, not this key, control what data it can read/write.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# In Supabase Dashboard > Authentication > URL Configuration, add this local
# URL (and the deployed HTTPS URL) as a Redirect URL so password-reset links
# can return to /reset-password. Do not put service-role credentials in VITE_.

# --- Supabase (server-side / scripts only — NEVER expose to the browser) ---
# Used only in trusted contexts: migration scripts, admin CLI tools, backups.
# Must never be prefixed with VITE_ or referenced from src/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_REF=your-project-ref

# --- App configuration ---
# Shop / tenant identity shown on PDF receipts and reports
VITE_SHOP_NAME="Your Jewellery Shop"
VITE_SHOP_ADDRESS="Shop address, City, State, PIN"
VITE_SHOP_GSTIN=
VITE_SHOP_PHONE=

# Default interest/loan business rules (overridable per-loan in the DB later)
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_LOCALE=en-IN

# --- Optional: error monitoring (Phase 3+) ---
VITE_SENTRY_DSN=
